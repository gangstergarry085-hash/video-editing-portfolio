# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev_anand_portfolio

# Auth & JWT
JWT_SECRET=change-me-to-a-long-random-secret-key
SESSION_SECRET=change-me-to-a-long-random-secret-key

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# CORS
CLIENT_URL=http://localhost:5173

# Storage: "local" | "cloudinary"
STORAGE_PROVIDER=local

# Cloudinary (only if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
